{
    "name": "atannex/desk-editor",
    "description": "A premium, first-class rich text editor for Laravel: Blade & Livewire components, uploads, mentions, math, code highlighting, tables, callouts, server-side sanitisation and a polished light/dark theme built with Tailwind CSS.",
    "keywords": [
        "laravel",
        "editor",
        "rich-text",
        "wysiwyg",
        "tiptap",
        "prosemirror",
        "blade",
        "livewire",
        "markdown",
        "tailwindcss"
    ],
    "license": "MIT",
    "homepage": "https://github.com/atannex/desk-editor",
    "support": {
        "issues": "https://github.com/atannex/desk-editor/issues",
        "source": "https://github.com/atannex/desk-editor"
    },
    "type": "library",
    "authors": [
        {
            "name": "Atannex Enterprise"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "symfony/html-sanitizer": "^7.1|^8.0"
    },
    "require-dev": {
        "filament/filament": "^4.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "laravel/reverb": "^1.5",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "livewire/livewire": "Bind the editor with wire:model (^3.0|^4.0)"
    },
    "autoload": {
        "psr-4": {
            "Atannex\\DeskEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atannex\\DeskEditor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atannex\\DeskEditor\\DeskEditorServiceProvider"
            ],
            "aliases": {
                "DeskEditor": "Atannex\\DeskEditor\\Facades\\DeskEditor"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
