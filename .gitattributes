* text=auto eol=lf

# Compiled assets ship with the package but are not reviewed as source.
/dist/** linguist-generated=true -diff
/resources/js/ui/icons.js linguist-generated=true
/resources/js/data/emojis.js linguist-generated=true

# Kept out of the Composer distribution.
/.github export-ignore
/tests export-ignore
/workbench export-ignore
/demo export-ignore
/scripts export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/build.mjs export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpunit.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/pint.json export-ignore
/playwright.config.mjs export-ignore
/vitest.config.mjs export-ignore
/testbench.yaml export-ignore
